# CityFix Environment Configuration Example
# Copy this file to .env and configure your local settings

# Django Secret Key (generate a secure random string for production)
SECRET_KEY=cityfix-dev-insecure-key-change-in-production-^9k8g12#4x

# Debug mode (True for local development, False for production)
DEBUG=True

# Allowed hosts (comma-separated list)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Defaults to SQLite if DB_ENGINE is empty or sqlite3)
# To use PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=cityfix_db
# DB_USER=cityfix_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

